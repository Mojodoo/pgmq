{
	"$schema": "https://biomejs.dev/schemas/1.7.3/schema.json",
	"files": {
		"ignore": [
			".expo/*",
			"static/*",
			"migrations/*",
			"dist/*",
			"build/",
			"infra/*",
			".vinxi/*",
			".output/*",
			"routeTree.gen.ts"
		]
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedImports": "error"
			},
			"nursery": {
				"useSortedClasses": "warn"
			},
			"security": {
				"noDangerouslySetInnerHtml": "off"
			}
		}
	}
}
